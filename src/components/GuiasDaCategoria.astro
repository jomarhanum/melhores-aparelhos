---
// Bloco no fim de cada hub: todos os guias e comparativos da mesma categoria.
// Os guias novos (inclusive os publicados pelo n8n) aparecem aqui sozinhos e já recebem link interno.
import { categorias } from '../data/categorias.mjs';
import { artigosDaSecao } from '../data/artigos.mjs';

const cat = categorias.find((c) => c.hub === Astro.url.pathname);
const itens = cat
  ? artigosDaSecao(cat.id)
      .filter((a) => a.url !== cat.hub)
      // Comparativos primeiro, depois os guias mais recentes.
      .sort((a, b) => (a.categoria === 'Guia' ? 1 : 0) - (b.categoria === 'Guia' ? 1 : 0) || b.publicado.localeCompare(a.publicado))
  : [];
---
{itens.length > 0 && (
  <section class="guias-cat" aria-labelledby="guias-cat-tit">
    <h2 id="guias-cat-tit">Guias de {cat!.nome.toLowerCase()}</h2>
    <ul>
      {itens.map((a) => (
        <li>
          <a href={a.url}>{a.h1}</a>
          <span>{a.resumo}</span>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .guias-cat ul { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 10px; }
  .guias-cat li { border: 1px solid var(--borda); border-radius: 12px; padding: 12px 16px; background: #fff; }
  .guias-cat a { font-weight: 700; display: block; }
  .guias-cat span { color: var(--texto-2); font-size: .95rem; }
</style>
