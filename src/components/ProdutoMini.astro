---
// Card compacto de produto para artigos de apoio: foto, destaque, specs-chave e botões de compra.
import { amazonLink, mercadoLivreLink, fotoProduto } from '../data/tipos';
import { buscarProduto } from '../data/catalogo';

interface Props {
  slug: string;
  posicao?: number;
  titulo?: string;
  destaque: string;
  specs: [string, string][];
  tipo?: string;
}
const { slug, posicao, titulo, destaque, specs, tipo = 'Ar-condicionado' } = Astro.props;
const p = buscarProduto(slug);
---
<div class="mini" id={`mini-${p.slug}`}>
  <div class="mini-topo">
    {posicao && <span class="mini-rank">{posicao}º</span>}
    <h3>{titulo ?? p.nome}</h3>
  </div>
  <div class="mini-grid">
    <img src={fotoProduto(p)} alt={`${tipo} ${p.marca} ${p.modelo}`} width="600" height="600" loading="lazy" decoding="async" />
    <div>
      <p>{destaque}</p>
      <ul class="mini-specs">{specs.map(([k, v]) => <li><span>{k}</span><strong>{v}</strong></li>)}</ul>
      <p class="mini-mais">
        Prós: {p.pros.slice(0, 3).join(' · ')}<br />
        Contras: {p.contras.slice(0, 2).join(' · ')}
      </p>
      {p.versoes && <p class="mini-volt">⚡ Não é bivolt: escolha na loja a versão 127 V ou 220 V da sua tomada.</p>}
      <div class="mini-botoes">
        {amazonLink(p) && <a class="btn btn-amazon btn-sm" href={amazonLink(p)!} target="_blank" rel="sponsored nofollow noopener" data-loja="amazon" data-produto={p.slug}>Ver preço na Amazon</a>}
        {mercadoLivreLink(p) && <a class="btn btn-ml btn-sm" href={mercadoLivreLink(p)!} target="_blank" rel="sponsored nofollow noopener" data-loja="mercadolivre" data-produto={p.slug}>Ver no Mercado Livre</a>}
      </div>
      <a class="mini-review" href={`${p.hub}#${p.slug}`}>Análise completa no comparativo →</a>
    </div>
  </div>
</div>

<style>
  .mini { border: 1px solid var(--borda); border-radius: 18px; padding: 22px; margin: 1.6rem 0; box-shadow: var(--sombra); }
  .mini-topo { display: flex; gap: 12px; align-items: center; }
  .mini-topo h3 { margin: 0; font-size: 1.25rem; }
  .mini-rank { flex-shrink: 0; width: 44px; height: 44px; border-radius: 12px; background: var(--azul); color: #fff; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .mini-grid { display: grid; grid-template-columns: 170px 1fr; gap: 22px; margin-top: 1rem; align-items: start; }
  .mini-grid img { width: 100%; aspect-ratio: 1; object-fit: contain; border: 1px solid var(--borda); border-radius: 12px; padding: 8px; }
  .mini-grid p { font-size: 1.02rem; }
  .mini-specs { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .mini-specs li { background: var(--gelo); border-radius: 10px; padding: 8px 12px; margin: 0; font-size: .95rem; line-height: 1.35; }
  .mini-specs span { display: block; color: var(--texto-2); font-size: .8rem; }
  .mini-mais { color: var(--texto-2); font-size: .95rem !important; }
  .mini-volt { background: #fff7e6; border: 1px solid #f6d58b; border-radius: 10px; padding: 8px 12px; font-size: .92rem !important; }
  .mini-botoes { display: flex; flex-wrap: wrap; gap: 10px; }
  .mini-botoes .btn { flex: 1 1 180px; }
  .mini-review { display: inline-block; margin-top: .8rem; font-weight: 700; font-size: .98rem; }
  @media (max-width: 640px) {
    .mini { padding: 18px 16px; }
    .mini-grid { grid-template-columns: 1fr; }
    .mini-grid img { max-width: 200px; margin: 0 auto; }
  }
</style>
