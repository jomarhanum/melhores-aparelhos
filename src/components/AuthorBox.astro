---
import { author } from '../data/site';
---
<aside class="autor-box" aria-label="Sobre o autor">
  <img src="/images/autor-jomar-hanum-240.webp" alt={`Foto de ${author.name}`} width="120" height="120" loading="lazy" decoding="async" />
  <div>
    <p class="autor-rot">Escrito por</p>
    <p class="autor-nome"><a href={author.url}>{author.name}</a></p>
    <p class="autor-cargo">{author.role}</p>
    <p>{author.bio}</p>
    <a href={author.url} class="autor-mais">Conheça o autor →</a>
  </div>
</aside>

<style>
  .autor-box { display: flex; gap: 22px; align-items: flex-start; background: var(--gelo); border: 1px solid var(--borda); border-radius: var(--raio); padding: 24px; margin: 2.5rem 0; }
  .autor-box img { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 4px solid #fff; box-shadow: var(--sombra); }
  .autor-box p { margin: 0 0 .5rem; font-size: 1.02rem; }
  .autor-rot { text-transform: uppercase; letter-spacing: .08em; font-size: .78rem !important; color: var(--texto-2); font-weight: 700; }
  .autor-nome { font-size: 1.35rem !important; font-weight: 800; }
  .autor-nome a { color: var(--texto); text-decoration: none; }
  .autor-cargo { color: var(--azul); font-weight: 600; }
  .autor-mais { font-weight: 700; font-size: 1rem; }
  @media (max-width: 560px) { .autor-box { flex-direction: column; align-items: center; text-align: center; } }
</style>
