---
// Campo de busca simples: envia para /busca/?q=termo, onde o Pagefind mostra os resultados.
---
<form class="busca-form" action="/busca/" method="get" role="search">
  <input type="search" name="q" placeholder="Busque um aparelho, marca ou dúvida" aria-label="Buscar no site" required />
  <button class="btn" type="submit">Buscar</button>
</form>
