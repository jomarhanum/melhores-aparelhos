---
import { amazonLink, mercadoLivreLink, fotoProduto, type Produto } from '../data/tipos';
interface Props { p: Produto; tipo?: string; }
const { p, tipo = 'Ar-condicionado' } = Astro.props;
// Reviews individuais publicados (slug do produto → URL)
const reviews: Record<string, string> = { 'electrolux-sp12f': '/review/electrolux-sp12f/' };
const reviewUrl = reviews[p.slug];
const specs = p.ficha;
---
<article class="produto" id={p.slug}>
  <header class="produto-topo">
    <span class="rank" aria-label={`Posição ${p.rank}`}>{p.rank}º</span>
    <div>
      {p.selo && <span class="selo">{p.selo}</span>}
      <h3>{p.nome}</h3>
      <p class="nota">Nota do editor: <strong>{p.nota.toLocaleString('pt-BR')}</strong>/10</p>
    </div>
  </header>

  <div class="produto-grid">
    <figure class="produto-img">
      <img src={fotoProduto(p)} alt={`${tipo} ${p.marca} ${p.modelo}`} width="600" height="600" loading={p.rank <= 1 ? 'eager' : 'lazy'} decoding="async" />
    </figure>
    <div>
      <p>{p.resumo}</p>
      <p class="ideal"><strong>Ideal para:</strong> {p.idealPara}</p>
      {reviewUrl && <p><a href={reviewUrl}><strong>Leia o review completo do {p.marca} {p.modelo} →</strong></a></p>}
      <div class="botoes">
        {amazonLink(p) && <a class="btn btn-amazon" href={amazonLink(p)!} target="_blank" rel="sponsored nofollow noopener" data-loja="amazon" data-produto={p.slug}>
          Ver preço na Amazon
        </a>}
        {mercadoLivreLink(p) && <a class="btn btn-ml" href={mercadoLivreLink(p)!} target="_blank" rel="sponsored nofollow noopener" data-loja="mercadolivre" data-produto={p.slug}>
          Ver no Mercado Livre
        </a>}
      </div>
    </div>
  </div>

  <h4>Ficha técnica</h4>
  <div class="tabela-wrap">
    <table class="ficha">
      <tbody>
        {specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
      </tbody>
    </table>
  </div>

  <div class="tres">
    <div>
      <h4>Características</h4>
      <ul>{p.caracteristicas.map((c) => <li>{c}</li>)}</ul>
    </div>
    <div>
      <h4>Benefícios no dia a dia</h4>
      <ul>{p.beneficios.map((c) => <li>{c}</li>)}</ul>
    </div>
  </div>

  <div class="caixa vantagens">
    <p class="caixa-tit">Diferenciais em relação aos concorrentes</p>
    <ul>{p.vantagens.map((c) => <li>{c}</li>)}</ul>
  </div>

  <div class="pc" role="group" aria-label={`Prós e contras do ${p.nome}`}>
    <div class="pc-col pros">
      <p class="pc-tit">👍 Prós</p>
      <ul>{p.pros.map((c) => <li>{c}</li>)}</ul>
    </div>
    <div class="pc-col contras">
      <p class="pc-tit">👎 Contras</p>
      <ul>{p.contras.map((c) => <li>{c}</li>)}</ul>
    </div>
  </div>

  {p.opiniao && (
    <div class="compradores">
      <p class="caixa-tit">💬 O que dizem os compradores</p>
      <div class="pc">
        <div>
          <p class="sub">Mais elogiado</p>
          <ul>{p.opiniao.elogios.map((c) => <li>{c}</li>)}</ul>
        </div>
        {p.opiniao.criticas.length > 0 && (
          <div>
            <p class="sub">Reclamações mais comuns</p>
            <ul>{p.opiniao.criticas.map((c) => <li>{c}</li>)}</ul>
          </div>
        )}
      </div>
      <p class="fonte">{p.opiniao.observacao ? `${p.opiniao.observacao} ` : ''}Resumo nosso das avaliações publicadas por compradores em lojas online (outubro de 2026).</p>
    </div>
  )}

  {p.versoes && (
    <p class="aviso-volt">⚡ <strong>Atenção à voltagem:</strong> este modelo não é bivolt. Ele é vendido em versões separadas de 127 V e 220 V. Na loja, escolha a versão da sua tomada antes de finalizar a compra.</p>
  )}

  <div class="botoes botoes-fim">
    {amazonLink(p) && <a class="btn btn-amazon" href={amazonLink(p)!} target="_blank" rel="sponsored nofollow noopener" data-loja="amazon" data-produto={p.slug}>Comprar na Amazon</a>}
    {mercadoLivreLink(p) && <a class="btn btn-ml" href={mercadoLivreLink(p)!} target="_blank" rel="sponsored nofollow noopener" data-loja="mercadolivre" data-produto={p.slug}>Comprar no Mercado Livre</a>}
  </div>
</article>

<style>
  .produto { border: 1px solid var(--borda); border-radius: 20px; padding: 28px; margin: 2.5rem 0; box-shadow: var(--sombra); background: #fff; }
  .produto-topo { display: flex; gap: 16px; align-items: flex-start; }
  .produto-topo h3 { margin: .3rem 0 .2rem; font-size: clamp(1.3rem, 3vw, 1.6rem); }
  .rank { flex-shrink: 0; width: 56px; height: 56px; border-radius: 16px; background: var(--azul); color: #fff; font-weight: 800; font-size: 1.4rem; display: flex; align-items: center; justify-content: center; }
  .selo { display: inline-block; background: #fff4d6; color: #7a4b00; font-weight: 700; font-size: .85rem; padding: 3px 12px; border-radius: 999px; }
  .nota { margin: 0; color: var(--texto-2); font-size: 1rem; }
  .nota strong { color: var(--verde); font-size: 1.2rem; }
  .produto-grid { display: grid; grid-template-columns: 220px 1fr; gap: 28px; margin-top: 1.4rem; align-items: start; }
  .produto-img { margin: 0; background: #fff; border: 1px solid var(--borda); border-radius: var(--raio); padding: 12px; text-align: center; }
  .produto-img img { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; }
  .produto-img figcaption { font-size: .92rem; margin-top: 10px; color: var(--texto-2); line-height: 1.4; }
  .ideal { background: var(--azul-claro); border-radius: 10px; padding: 12px 16px; }
  .botoes { display: flex; flex-wrap: wrap; gap: 12px; }
  .botoes .btn { flex: 1 1 200px; }
  .botoes-fim { margin-top: 1.6rem; }
  h4 { font-size: 1.15rem; margin: 1.8rem 0 .6rem; }
  .ficha { min-width: 0; }
  .ficha th { width: 38%; background: var(--gelo); font-weight: 700; }
  .tres { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .tres ul { padding-left: 1.2rem; }
  .vantagens { background: #f3f0ff; border-color: #ddd6fe; }
  .pc { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 1.5rem; }
  .pc-col { border-radius: var(--raio); padding: 18px 20px; }
  .pc-col ul { list-style: none; padding: 0; margin: 0; }
  .pc-col li { padding-left: 28px; position: relative; font-size: 1.02rem; }
  .pc-tit { font-weight: 800; font-size: 1.1rem; margin-bottom: .6rem; }
  .compradores { border: 1px solid var(--borda); border-radius: var(--raio); padding: 20px 22px; margin-top: 1.5rem; }
  .compradores .pc { margin-top: .4rem; }
  .compradores ul { padding-left: 1.2rem; margin: 0; }
  .compradores li { font-size: 1.02rem; }
  .compradores .sub { font-weight: 700; margin-bottom: .3rem; color: var(--texto-2); font-size: .95rem; text-transform: uppercase; letter-spacing: .04em; }
  .compradores .fonte { font-size: .88rem; color: var(--texto-2); margin: 1rem 0 0; }
  .aviso-volt { background: #fff7e6; border: 1px solid #f6d58b; border-radius: 10px; padding: 12px 16px; font-size: 1rem; margin: 1.5rem 0 0; }
  .pros { background: var(--verde-claro); border: 1px solid #b7e4c7; }
  .pros li::before { content: '✔'; position: absolute; left: 0; color: var(--verde); font-weight: 800; }
  .contras { background: var(--vermelho-claro); border: 1px solid #f5c2bd; }
  .contras li::before { content: '✖'; position: absolute; left: 0; color: var(--vermelho); font-weight: 800; }
  @media (max-width: 720px) {
    .produto { padding: 20px 16px; }
    .produto-grid, .tres, .pc { grid-template-columns: 1fr; }
    .produto-img { max-width: 260px; margin: 0 auto; }
  }
</style>
