---
import { site } from '../data/site';
interface Props { title: string; }
const { title } = Astro.props;
const url = new URL(Astro.url.pathname, site.url).href;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const redes = [
  { nome: 'WhatsApp', cor: '#25D366', href: `https://api.whatsapp.com/send?text=${t}%20${u}`, d: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.8-.1 1.4Z' },
  { nome: 'Facebook', cor: '#1877F2', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, d: 'M14 8h3V4h-3c-2.8 0-4 1.7-4 4.3V10H7v4h3v8h4v-8h3l1-4h-4V8.6c0-.4.3-.6.6-.6Z' },
  { nome: 'X', cor: '#000', href: `https://twitter.com/intent/tweet?text=${t}&url=${u}`, d: 'M17.8 3h3.1l-6.8 7.7 8 10.3h-6.3l-4.9-6.4L5.3 21H2.2l7.3-8.3L1.8 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z' },
  { nome: 'LinkedIn', cor: '#0A66C2', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, d: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm6.5 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4V9.5Z' },
  { nome: 'Telegram', cor: '#26A5E4', href: `https://t.me/share/url?url=${u}&text=${t}`, d: 'M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2l-11 6.9L1.8 11.7c-1-.3-1-1 .2-1.5L20.6 3c.8-.3 1.6.2 1.3 1.3Z' },
  { nome: 'Pinterest', cor: '#E60023', href: `https://pinterest.com/pin/create/button/?url=${u}&description=${t}`, d: 'M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.8 0 1.2.6 1.2 1.4 0 .8-.5 2.1-.8 3.2-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.1-4.5 4.4 0 .9.3 1.8.8 2.3l.1.4-.3 1.1c0 .2-.2.3-.4.2-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1 0-2-.5-2.4-1.2l-.6 2.5c-.2.9-.9 2.1-1.3 2.8A10 10 0 1 0 12 2Z' },
];
---
<div class="share" aria-label="Compartilhar" data-pagefind-ignore>
  <span class="share-tit">Compartilhe:</span>
  {redes.map((r) => (
    <a href={r.href} target="_blank" rel="noopener nofollow" style={`--c:${r.cor}`} aria-label={`Compartilhar no ${r.nome}`} title={r.nome}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d={r.d} /></svg>
    </a>
  ))}
  <button type="button" class="share-copiar" data-url={url} aria-label="Copiar link" title="Copiar link">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M10.6 13.4a1 1 0 0 1 0-1.4l3.5-3.5a1 1 0 1 1 1.4 1.4L12 13.4a1 1 0 0 1-1.4 0Zm-2.1 6.3a4.5 4.5 0 0 1-3.2-7.7l2.1-2.1a1 1 0 1 1 1.4 1.4l-2.1 2.1a2.5 2.5 0 0 0 3.5 3.5l2.1-2.1a1 1 0 0 1 1.4 1.4l-2.1 2.1a4.5 4.5 0 0 1-3.1 1.4Zm8-5.3a1 1 0 0 1-.7-1.7l2.1-2.1a2.5 2.5 0 0 0-3.5-3.5l-2.1 2.1a1 1 0 1 1-1.4-1.4l2.1-2.1a4.5 4.5 0 0 1 6.4 6.4l-2.1 2.1a1 1 0 0 1-.8.2Z"/></svg>
    <span class="share-ok" hidden>Copiado!</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share-copiar').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        if (navigator.share) { await navigator.share({ url: b.dataset.url, title: document.title }); return; }
        await navigator.clipboard.writeText(b.dataset.url || location.href);
        const ok = b.querySelector<HTMLElement>('.share-ok');
        if (ok) { ok.hidden = false; setTimeout(() => (ok.hidden = true), 1800); }
      } catch {}
    });
  });
</script>

<style>
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 1.5rem 0; }
  .share-tit { font-weight: 700; font-size: 1rem; margin-right: 4px; }
  .share a, .share button { width: 42px; height: 42px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--c, #475569); color: #fff; border: 0; cursor: pointer; position: relative; transition: transform .15s; }
  .share a:hover, .share button:hover { transform: translateY(-2px); color: #fff; }
  .share-copiar { --c: #475569; }
  .share-ok { position: absolute; top: -30px; background: #111; color: #fff; font-size: .75rem; padding: 2px 8px; border-radius: 6px; white-space: nowrap; }
</style>
