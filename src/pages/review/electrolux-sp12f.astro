---
import Artigo from '../../layouts/Artigo.astro';
import { produtoPorSlug, fotoProduto, amazonLink, mercadoLivreLink } from '../../data/produtos';
import { site, author } from '../../data/site';

const p = produtoPorSlug('electrolux-sp12f');
const hisense = produtoPorSlug('hisense-ap-12cwbrnps01');
const philco = produtoPorSlug('philco-pac12000f5');

const faq = [
  { q: 'O Electrolux SP12F é bivolt?', a: 'Não. Ele é vendido em duas versões separadas, uma de 127 V e outra de 220 V. Confira a voltagem da sua tomada e escolha a versão certa na loja antes de finalizar a compra.' },
  { q: 'O Electrolux SP12F tem Wi-Fi?', a: 'Sim. Ele pode ser controlado pelo aplicativo da Electrolux e é compatível com assistentes de voz, além do controle remoto que acompanha o aparelho.' },
  { q: 'Para quantos m² serve o Electrolux SP12F?', a: 'Com 12.000 BTUs, ele atende bem cômodos de até cerca de 15 m² em condições normais. Em quartos que pegam muito sol à tarde, o rendimento cai, e há compradores relatando dificuldade em dias muito quentes.' },
  { q: 'O Electrolux SP12F faz muito barulho?', a: 'O fabricante informa entre 49 e 52 dB. Compradores comparam o som ao de um ventilador forte e dizem que o modo Dormir Bem deixa o ruído aceitável à noite.' },
  { q: 'Qual gás o Electrolux SP12F usa?', a: 'As fichas técnicas publicadas pelas lojas divergem entre R-32 e R-410A. Se isso for importante para você, confira a etiqueta do aparelho ou o manual no site da Electrolux.' },
];

const pageUrl = `${site.url}/review/electrolux-sp12f/`;
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.nome,
  brand: { '@type': 'Brand', name: p.marca },
  model: p.modelo,
  image: `${site.url}${fotoProduto(p)}`,
  description: p.resumo,
  url: pageUrl,
  review: {
    '@type': 'Review',
    author: { '@type': 'Person', name: author.name, url: `${site.url}${author.url}` },
    datePublished: '2026-10-19',
    reviewBody: 'Melhor ar-condicionado portátil para a maioria das pessoas: 12.000 BTUs, Wi-Fi, comando de voz e eficiência nível A, com ótimo custo-benefício.',
    reviewRating: { '@type': 'Rating', ratingValue: p.nota, bestRating: 10, worstRating: 0 },
    positiveNotes: { '@type': 'ItemList', itemListElement: p.pros.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t })) },
    negativeNotes: { '@type': 'ItemList', itemListElement: p.contras.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t })) },
  },
}];
const specs: [string, string][] = [
  ['Capacidade', '12.000 BTUs'], ['Ciclo', 'Só frio'], ['Área indicada (estimativa)', p.area], ['Voltagem', p.voltagem],
  ['Ruído', p.ruido], ['Eficiência energética', 'Nível A'], ['Peso', p.peso], ['Dimensões', p.dimensoes!],
  ['Wi-Fi', p.wifi], ['Controle', 'Remoto, aplicativo e voz'], ['Funções', p.funcoes.join(', ')], ['Garantia', '1 ano'],
];
---
<Artigo faq={faq} jsonLd={jsonLd} relacionados={['/melhor-ar-condicionado-portatil/', '/melhor-ar-condicionado-portatil-silencioso/', '/guias/quantos-btus-preciso/', '/guias/como-instalar-ar-condicionado-portatil/']}>
  <div class="veredito">
    <img src={fotoProduto(p)} alt="Ar-condicionado portátil Electrolux SP12F 12.000 BTUs" width="600" height="600" fetchpriority="high" />
    <div>
      <p class="v-tit">Veredito</p>
      <p class="v-nota"><strong>{p.nota.toLocaleString('pt-BR')}</strong>/10</p>
      <p><strong>Sim, o Electrolux SP12F é bom</strong> e é o 1º colocado do nosso <a href="/melhor-ar-condicionado-portatil/">ranking de 2026</a>. Ele reúne Wi-Fi, comando de voz, eficiência nível A e modo dormir com um ótimo custo-benefício. Não é para quem precisa de aquecimento ou de silêncio absoluto.</p>
      <div class="botoes">
        {amazonLink(p) && <a class="btn btn-amazon" href={amazonLink(p)!} target="_blank" rel="sponsored nofollow noopener" data-loja="amazon" data-produto={p.slug}>Ver preço na Amazon</a>}
        {mercadoLivreLink(p) && <a class="btn btn-ml" href={mercadoLivreLink(p)!} target="_blank" rel="sponsored nofollow noopener" data-loja="mercadolivre" data-produto={p.slug}>Ver no Mercado Livre</a>}
      </div>
    </div>
  </div>

  <p class="aviso-volt">⚡ <strong>Antes de comprar:</strong> o SP12F <strong>não é bivolt</strong>. Ele é vendido em versões de 127 V e de 220 V. Escolha a versão da sua tomada na página da loja.</p>

  <h2 id="ficha">Ficha técnica</h2>
  <div class="tabela-wrap">
    <table class="ficha">
      <tbody>{specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
    </table>
  </div>
  <p class="nota">Dados dos anúncios oficiais e do fabricante, conferidos em outubro de 2026.</p>

  <h2 id="destaques">O que ele tem de melhor</h2>
  <h3>Wi-Fi e comando de voz</h3>
  <p>É o grande diferencial nessa faixa. Pelo aplicativo você liga o ar antes de chegar em casa, ajusta a temperatura da cama ou programa horários. A compatibilidade com assistentes de voz permite ligar e desligar sem procurar o controle.</p>
  <h3>Modo Dormir Bem</h3>
  <p>Ajusta a temperatura ao longo da noite e reduz a ventilação. Nas avaliações de compradores, é citado como o recurso que torna o barulho aceitável para dormir.</p>
  <h3>Eficiência nível A e filtro lavável</h3>
  <p>A classificação de eficiência nível A ajuda na conta de luz, e o filtro ionizador lavável dispensa reposição. Veja <a href="/guias/como-limpar-ar-condicionado-portatil/">como limpar o filtro</a>.</p>

  <h2 id="fracos">Pontos fracos</h2>
  <ul>
    <li><strong>Pesado e alto:</strong> são 30 kg e 88 cm de altura, um dos maiores da lista. As rodinhas ajudam, mas subir escada é trabalhoso.</li>
    <li><strong>Só refrigera:</strong> não tem modo aquecer. Se o inverno é rigoroso onde você mora, veja os <a href="/melhor-ar-condicionado-portatil-quente-e-frio/">portáteis quente e frio</a>.</li>
    <li><strong>Barulho de portátil:</strong> como todo modelo do tipo, o compressor fica no cômodo.</li>
    <li><strong>Não é bivolt:</strong> atenção na hora de escolher a versão.</li>
  </ul>

  <div class="pc" role="group" aria-label="Prós e contras do Electrolux SP12F">
    <div class="pc-col pros"><p class="pc-tit">👍 Prós</p><ul>{p.pros.map((c) => <li>{c}</li>)}</ul></div>
    <div class="pc-col contras"><p class="pc-tit">👎 Contras</p><ul>{p.contras.map((c) => <li>{c}</li>)}</ul></div>
  </div>

  <h2 id="compradores">O que dizem os compradores</h2>
  <p>Resumimos os temas que mais aparecem nas avaliações publicadas em lojas online:</p>
  <ul>
    {p.opiniao.elogios.map((c) => <li>👍 {c}</li>)}
    {p.opiniao.criticas.map((c) => <li>👎 {c}</li>)}
  </ul>
  <p>Na média, a percepção é positiva para quartos pequenos e médios, sobretudo entre quem já sabia que um portátil não rende como um split. As notas mais baixas vêm de quem tentou climatizar um cômodo maior ou muito quente.</p>

  <h2 id="comparacao">Electrolux SP12F x concorrentes</h2>
  <div class="tabela-wrap">
    <table>
      <thead><tr><th></th><th>Electrolux SP12F</th><th>Hisense AP-12CW</th><th>Philco PAC12000F5</th></tr></thead>
      <tbody>
        <tr><th scope="row">Posição no ranking</th><td>1º</td><td>2º</td><td>3º</td></tr>
        <tr><th scope="row">Wi-Fi</th><td>Sim + voz</td><td>Sim</td><td>Não</td></tr>
        <tr><th scope="row">Ruído</th><td>{p.ruido}</td><td>{hisense.ruido}</td><td>{philco.ruido}</td></tr>
        <tr><th scope="row">Voltagem</th><td>127 V ou 220 V</td><td>127 V</td><td>127 V ou 220 V</td></tr>
        <tr><th scope="row">Peso</th><td>{p.peso}</td><td>{hisense.peso}</td><td>{philco.peso}</td></tr>
        <tr><th scope="row">Destaque</th><td>Pacote mais completo</td><td>Modo dormir mais silencioso</td><td>Oscilação e simplicidade</td></tr>
      </tbody>
    </table>
  </div>
  <p>Se você dorme mal com barulho, o <a href="/melhor-ar-condicionado-portatil/#hisense-ap-12cwbrnps01">Hisense</a> é a melhor alternativa. Se não faz questão de Wi-Fi, o <a href="/melhor-ar-condicionado-portatil/#philco-pac12000f5">Philco PAC12000F5</a> é mais leve e tem oscilação de ar.</p>

  <h2 id="para-quem">Para quem vale a pena</h2>
  <div class="pc">
    <div class="pc-col pros"><p class="pc-tit">Compre se...</p><ul><li>O cômodo tem até cerca de 15 m²</li><li>Você quer controlar pelo celular ou por voz</li><li>Mora de aluguel ou não pode instalar split</li><li>Quer uma marca com boa assistência</li></ul></div>
    <div class="pc-col contras"><p class="pc-tit">Evite se...</p><ul><li>Precisa de aquecimento no inverno</li><li>O cômodo é grande ou muito ensolarado</li><li>Tem sono muito leve</li><li>Vai carregar o aparelho por escadas com frequência</li></ul></div>
  </div>

  <h2>Conclusão</h2>
  <p>O <strong>Electrolux SP12F</strong> é a escolha mais equilibrada entre os portáteis de 2026: recursos de casa inteligente, eficiência nível A e um preço competitivo. Escolha a voltagem certa, instale com a <a href="/guias/como-instalar-ar-condicionado-portatil/">mangueira curta e a janela bem vedada</a> e ele vai entregar o que promete.</p>
  <div class="botoes">
    {amazonLink(p) && <a class="btn btn-amazon" href={amazonLink(p)!} target="_blank" rel="sponsored nofollow noopener" data-loja="amazon" data-produto={p.slug}>Ver preço na Amazon</a>}
    {mercadoLivreLink(p) && <a class="btn btn-ml" href={mercadoLivreLink(p)!} target="_blank" rel="sponsored nofollow noopener" data-loja="mercadolivre" data-produto={p.slug}>Ver no Mercado Livre</a>}
  </div>
  <p class="nota">Review baseado em pesquisa (especificações oficiais e avaliações de compradores), sem teste em laboratório. Nota: opinião editorial de {author.name}.</p>
</Artigo>

<style>
  .veredito { display: grid; grid-template-columns: 200px 1fr; gap: 24px; border: 2px solid var(--azul); border-radius: 20px; padding: 22px; margin: 1.5rem 0; }
  .veredito img { width: 100%; aspect-ratio: 1; object-fit: contain; }
  .v-tit { text-transform: uppercase; letter-spacing: .08em; font-weight: 800; color: var(--azul); font-size: .85rem; margin: 0; }
  .v-nota { font-size: 1.1rem; margin: 0 0 .6rem; color: var(--texto-2); }
  .v-nota strong { font-size: 2.2rem; color: var(--verde); }
  .botoes { display: flex; flex-wrap: wrap; gap: 12px; margin: 1rem 0; }
  .botoes .btn { flex: 1 1 200px; }
  .aviso-volt { background: #fff7e6; border: 1px solid #f6d58b; border-radius: 10px; padding: 12px 16px; font-size: 1rem; }
  .ficha { min-width: 0; }
  .ficha th { width: 42%; background: var(--gelo); }
  .nota { font-size: .95rem; color: var(--texto-2); }
  .pc { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 1.5rem 0; }
  .pc-col { border-radius: var(--raio); padding: 18px 20px; }
  .pc-col ul { list-style: none; padding: 0; margin: 0; }
  .pc-col li { padding-left: 28px; position: relative; font-size: 1.02rem; }
  .pc-tit { font-weight: 800; font-size: 1.1rem; margin-bottom: .6rem; }
  .pros { background: var(--verde-claro); border: 1px solid #b7e4c7; }
  .pros li::before { content: '✔'; position: absolute; left: 0; color: var(--verde); font-weight: 800; }
  .contras { background: var(--vermelho-claro); border: 1px solid #f5c2bd; }
  .contras li::before { content: '✖'; position: absolute; left: 0; color: var(--vermelho); font-weight: 800; }
  @media (max-width: 640px) {
    .veredito, .pc { grid-template-columns: 1fr; }
    .veredito img { max-width: 200px; margin: 0 auto; }
  }
</style>
