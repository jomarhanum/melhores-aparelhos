---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ShareButtons from '../components/ShareButtons.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { bancadas } from '../data/bancada';
import { fotoProduto } from '../data/tipos';
import { site, author } from '../data/site';
import { artigoPorUrl } from '../data/artigos.mjs';

const meta = artigoPorUrl('/melhor-forno-eletrico-de-bancada/')!;
const publicado = `${meta.publicado}T09:00:00-03:00`;
const atualizado = `${meta.atualizado}T09:00:00-03:00`;
const dataExibida = new Date(`${meta.atualizado}T12:00:00-03:00`).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
const title = meta.titulo;
const description = meta.descricao;
const pageUrl = `${site.url}${meta.url}`;
const b = (slug: string) => bancadas.find((x) => x.slug === slug)!;

const faq = [
  { q: 'Qual o melhor forno elétrico de bancada de 2026?', a: 'Para a maioria das famílias, o Philco PFE65 é o melhor: 65 litros, dourador, timer de até 2 horas com desligamento automático e luz interna. Para quem faz bolos e pães, o Oster de 45 litros com convecção assa de forma mais uniforme.' },
  { q: 'Quantos litros deve ter um forno de bancada?', a: 'Até 10 litros para lanches; de 40 a 50 litros para famílias de até 4 pessoas; 60 litros ou mais para famílias grandes e assados. Veja o guia completo de tamanhos.' },
  { q: 'Forno elétrico de bancada gasta muita energia?', a: 'Um forno de 1.800 W ligado 1 hora gasta até 1,8 kWh; com tarifa de R$ 0,90 por kWh, até R$ 1,62. O termostato desliga as resistências parte do tempo depois de aquecido, então o gasto real fica menor.' },
  { q: 'Forno de bancada precisa de tomada especial?', a: 'Modelos de 1.500 W a 2.000 W puxam bastante corrente, principalmente em 127 V. Use uma tomada exclusiva, sem extensão ou benjamim, e de 20 A quando o plugue for de 20 A.' },
  { q: 'O que é convecção no forno de bancada?', a: 'É um ventilador interno que faz o ar quente circular, para as receitas assarem por igual. Na nossa lista, o Oster de 45 litros tem convecção.' },
  { q: 'Forno de bancada é bivolt?', a: 'Nenhum dos modelos desta lista é bivolt. Eles são vendidos em versões de 127 V ou 220 V. Confira a tomada e escolha a versão certa na loja.' },
];

const destaques = [
  { rotulo: 'Melhor no geral', x: b('philco-pfe65') },
  { rotulo: 'Melhor para assar por igual (convecção)', x: b('oster-ofor455') },
  { rotulo: 'Mais funções', x: b('fischer-gourmet-grill') },
  { rotulo: 'Melhor custo-benefício', x: b('philco-pfe52p') },
  { rotulo: 'Com espeto giratório', x: b('nardelli-smart-60s') },
  { rotulo: 'Mini forno para lanches', x: b('mondial-pratic-cook') },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: [`${site.url}${meta.imagem}`],
    datePublished: publicado,
    dateModified: atualizado,
    inLanguage: 'pt-BR',
    mainEntityOfPage: pageUrl,
    author: { '@type': 'Person', name: author.name, url: `${site.url}${author.url}`, image: `${site.url}${author.photo}`, jobTitle: author.role },
    publisher: { '@id': `${site.url}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Fornos', item: `${site.url}/fornos/` },
      { '@type': 'ListItem', position: 3, name: 'Melhor forno elétrico de bancada', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Melhores fornos elétricos de bancada de 2026',
    numberOfItems: bancadas.length,
    itemListElement: bancadas.map((x) => ({
      '@type': 'ListItem',
      position: x.rank,
      item: {
        '@type': 'Product',
        name: x.nome,
        brand: { '@type': 'Brand', name: x.marca },
        model: x.modelo,
        url: `${pageUrl}#${x.slug}`,
        description: x.resumo,
        image: `${site.url}${fotoProduto(x)}`,
        review: {
          '@type': 'Review',
          author: { '@type': 'Person', name: author.name },
          datePublished: publicado,
          reviewRating: { '@type': 'Rating', ratingValue: x.nota, bestRating: 10, worstRating: 0 },
          positiveNotes: { '@type': 'ItemList', itemListElement: x.pros.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t })) },
          negativeNotes: { '@type': 'ItemList', itemListElement: x.contras.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t })) },
        },
      },
    })),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((q) => ({ '@type': 'Question', name: q.q, acceptedAnswer: { '@type': 'Answer', text: q.a } })) },
];
---
<Base title={title} description={description} type="article" published={publicado} modified={atualizado} jsonLd={jsonLd} image={meta.imagem} imageAlt="Comparativo dos melhores fornos elétricos de bancada de 2026">
  <section class="hero">
    <div class="leitura">
      <nav class="migalhas" aria-label="Você está em">
        <ol><li><a href="/">Home</a></li><li><a href="/fornos/">Fornos</a></li><li aria-current="page">Melhor forno elétrico de bancada</li></ol>
      </nav>
      <h1>{meta.h1}</h1>
      <p class="subtitulo">Comparamos os 10 fornos elétricos de bancada mais recomendados do Brasil, do mini de 6 litros ao de 65 litros. Veja capacidade, potência, temperatura, prós e contras e descubra qual combina com a sua cozinha.</p>
      <div class="autor-linha">
        <img src={author.photoSmall} alt={`Foto de ${author.name}`} width="52" height="52" />
        <div>
          Por <a href={author.url} rel="author">{author.name}</a><br />
          Atualizado em <time datetime={atualizado}>{dataExibida}</time> · {meta.minutos} min de leitura
        </div>
      </div>
      <ShareButtons title={title} />
    </div>
  </section>

  <div class="leitura artigo">
    <p class="aviso-afiliado"><strong>Transparência:</strong> este artigo tem links de afiliado. Se você comprar por eles, podemos receber uma pequena comissão, sem nenhum custo extra para você. Isso não muda a nossa opinião. <a href="/divulgacao-de-afiliados/">Saiba mais</a>.</p>

    <p>O forno elétrico de bancada é a solução para quem não tem forno embutido, mora de aluguel ou quer um segundo forno para o dia a dia. <strong>Não precisa de instalação</strong>: é só colocar na bancada e ligar na tomada certa.</p>
    <p>Mas há modelos de todos os tamanhos, do mini forno de lanches ao de 65 litros que assa um frango inteiro. Reunimos os <strong>10 melhores de 2026</strong> e explicamos o que realmente importa na escolha.</p>

    <div class="caixa resposta">
      <p class="caixa-tit">⚡ Resposta rápida: os melhores de 2026</p>
      <ol class="lista-destaques">
        {destaques.map((d) => <li><strong>{d.rotulo}:</strong> <a href={`#${d.x.slug}`}>{d.x.nome}</a></li>)}
      </ol>
    </div>

    <nav class="caixa sumario" aria-label="Sumário">
      <p class="caixa-tit">📑 Neste artigo</p>
      <ol>
        <li><a href="#comparativo">Tabela comparativa</a></li>
        <li><a href="#como-escolher">Como escolher</a></li>
        <li><a href="#ranking">Os 10 melhores modelos</a></li>
        <li><a href="#cuidados">Onde colocar e tomada</a></li>
        <li><a href="#consumo">Consumo de energia</a></li>
        <li><a href="#metodologia">Como fizemos este ranking</a></li>
        <li><a href="#perguntas">Perguntas frequentes</a></li>
      </ol>
    </nav>

    <h2 id="comparativo">Tabela comparativa: os 10 melhores lado a lado</h2>
    <p>Clique no nome para ir direto à análise completa.</p>
  </div>

  <div class="wrap">
    <div class="tabela-wrap">
      <table>
        <caption class="sr-only">Comparativo dos 10 melhores fornos elétricos de bancada de 2026</caption>
        <thead><tr><th>#</th><th>Modelo</th><th>Litros</th><th>Potência</th><th>Temperatura</th><th>Timer</th><th>Destaque</th></tr></thead>
        <tbody>
          {bancadas.map((x) => (
            <tr>
              <td><strong>{x.rank}º</strong></td>
              <td><a href={`#${x.slug}`}>{x.marca} {x.modelo.split(' (')[0]}</a></td>
              <td>{x.litros}</td>
              <td>{x.potencia?.split(' (')[0] ?? '—'}</td>
              <td>{x.temperatura ?? '—'}</td>
              <td>{x.timer?.match(/\d+ min/)?.[0] ?? '—'}</td>
              <td>{x.selo}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="nota-preco">"—" indica dado não encontrado ou divergente entre as fontes. Nenhum modelo é bivolt. Os preços mudam com frequência: confira o valor atualizado nos botões de cada produto.</p>
  </div>

  <div class="leitura artigo">
    <h2 id="como-escolher">Como escolher o melhor forno elétrico de bancada</h2>

    <h3>1. Capacidade</h3>
    <div class="tabela-wrap">
      <table class="tab-curta">
        <thead><tr><th>Perfil</th><th>Capacidade</th><th>Exemplos da lista</th></tr></thead>
        <tbody>
          <tr><td>1 pessoa, lanches</td><td>Até 10 litros</td><td>Mondial Pratic Cook</td></tr>
          <tr><td>2 a 4 pessoas</td><td>42 a 52 litros</td><td>Philco PFE52P, Oster, Fischer, Britânia BFE55P, Mondial Family Grill, Suggar</td></tr>
          <tr><td>Família grande, assados</td><td>60 a 65 litros</td><td>Philco PFE65, Nardelli SMART60-S</td></tr>
        </tbody>
      </table>
    </div>
    <p>Guia completo: <a href="/guias/qual-tamanho-de-forno-eletrico/">qual tamanho de forno elétrico comprar</a>.</p>

    <h3>2. Potência e voltagem</h3>
    <p>Os fornos da lista vão de 650 W (mini forno) a 2.000 W. Mais potência aquece mais rápido, mas exige tomada adequada, principalmente em 127 V. <strong>Nenhum modelo é bivolt</strong>: confira a tomada e escolha a versão certa na loja.</p>

    <h3>3. Temperatura e timer</h3>
    <p>Para a maioria das receitas, até 230 °C ou 250 °C basta. Fornos que chegam a 300 °C (Nardelli e Fischer Premier) ajudam em pizzas crocantes. Prefira <strong>timer com desligamento automático</strong>; timers de 120 minutos dão mais folga para assados.</p>

    <h3>4. Recursos que fazem diferença</h3>
    <ul>
      <li><strong>Dourador ou grill:</strong> gratina lasanhas e dá cor aos assados.</li>
      <li><strong>Resistências com controle individual:</strong> escolher assar por cima ou por baixo.</li>
      <li><strong>Convecção:</strong> assa por igual (Oster).</li>
      <li><strong>Espeto giratório:</strong> frango de padaria em casa (Nardelli).</li>
      <li><strong>Luz interna:</strong> acompanhar a receita sem abrir a porta.</li>
      <li><strong>Bandeja de resíduos e interior Easy Clean:</strong> limpeza mais fácil.</li>
    </ul>
    <p>Na dúvida entre bancada e embutir? Veja <a href="/guias/forno-de-bancada-ou-de-embutir/">qual escolher</a>. Pensando em air fryer? Compare em <a href="/guias/forno-eletrico-ou-air-fryer/">forno elétrico ou air fryer</a>.</p>

    <h2 id="ranking">Os 10 melhores fornos elétricos de bancada de 2026</h2>
    <p>Análise completa de cada modelo, do 1º ao 10º lugar, com ficha técnica, benefícios e o quadro de prós e contras.</p>

    {bancadas.map((x) => <ProductCard p={x} tipo="Forno elétrico de bancada" />)}

    <section>
      <h2 id="cuidados">Onde colocar e qual tomada usar</h2>
      <ul>
        <li><strong>Bancada firme</strong>, resistente ao calor e longe de cortinas e da pia.</li>
        <li><strong>Espaço livre</strong> nas laterais, atrás e em cima para ventilar, conforme o manual.</li>
        <li><strong>Tomada exclusiva</strong>, sem extensão ou benjamim; de 20 A quando o plugue for de 20 A.</li>
        <li><strong>Nunca embuta</strong> um forno de bancada em armário fechado.</li>
      </ul>

      <h2 id="consumo">Quanto o forno de bancada gasta?</h2>
      <p>A conta é: <strong>potência (W) × horas ÷ 1.000 = kWh</strong>. Um forno de 1.800 W ligado 1 hora gasta até 1,8 kWh; com tarifa de R$ 0,90 por kWh (valor de exemplo), até R$ 1,62. Depois de aquecido, o termostato desliga as resistências parte do tempo e o gasto real fica menor. Calcule o seu em <a href="/guias/forno-eletrico-gasta-muita-energia/">forno elétrico gasta muita energia?</a></p>

      <h2 id="metodologia">Como fizemos este ranking</h2>
      <p>Este é um comparativo baseado em pesquisa, não em testes de laboratório. Partimos dos modelos mais recomendados pelos principais guias de compra do Brasil e conferimos as especificações nas fichas técnicas das lojas, dos comparadores e dos fabricantes. Quando as fontes divergem, deixamos o dado de fora em vez de arriscar.</p>
      <p>Comparamos os modelos em cinco critérios: <strong>capacidade</strong>, <strong>recursos de cozimento</strong> (temperatura, dourador, grill, convecção), <strong>praticidade</strong> (timer, luz, limpeza), <strong>tamanho e potência</strong> e <strong>custo-benefício</strong>. A nota de cada forno é a opinião editorial de {author.name}. Nenhuma marca pagou para aparecer nesta lista.</p>
    </section>

    <section>
      <h2 id="perguntas">Perguntas frequentes sobre forno elétrico de bancada</h2>
      <div class="faq">
        {faq.map((q) => (
          <details>
            <summary>{q.q}</summary>
            <p>{q.a}</p>
          </details>
        ))}
      </div>

      <h2 id="conclusao">Conclusão: qual forno de bancada comprar?</h2>
      <p>Para a maioria das famílias, o <strong>{bancadas[0].nome}</strong> é a melhor compra: grande, com dourador e timer longo. Quem faz bolos e pães deve olhar o <strong>Oster de 45 litros com convecção</strong>, e quem quer gastar menos tem no <strong>Philco PFE52P</strong> o melhor equilíbrio. Para lanches rápidos, o mini <strong>Mondial Pratic Cook</strong> resolve.</p>
      <p>Tem cozinha planejada? Veja também os <a href="/melhor-forno-eletrico-de-embutir/">melhores fornos elétricos de embutir</a>.</p>

      <ShareButtons title={title} />
      <AuthorBox />
    </section>
  </div>
</Base>

<style>
  .artigo { padding-top: 28px; }
  .resposta { background: var(--azul-claro); border-color: #bcd7f3; }
  .lista-destaques { padding-left: 1.2rem; margin: 0; }
  .nota-preco { font-size: .92rem; color: var(--texto-2); }
  .tab-curta { min-width: 0; }
  .faq details { border: 1px solid var(--borda); border-radius: 12px; padding: 4px 20px; margin-bottom: 12px; background: #fff; }
  .faq summary { cursor: pointer; font-weight: 700; padding: 14px 30px 14px 0; list-style: none; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 0; top: 10px; font-size: 1.6rem; color: var(--azul); }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { margin-top: 0; }
</style>
