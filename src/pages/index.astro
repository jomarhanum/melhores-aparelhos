---
import Base from '../layouts/Base.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { site } from '../data/site';
import { artigos } from '../data/artigos.mjs';
import { categorias, grupos } from '../data/categorias.mjs';

const title = 'Melhores Aparelhos: Reviews e Comparativos Honestos de 2026';
const description = site.description;
const comparativos = artigos.filter((a) => a.categoria !== 'Guia' && !categorias.some((c) => c.hub === a.url));
const guias = artigos.filter((a) => a.categoria === 'Guia');
---
<Base title={title} description={description}>
  <section class="home-hero">
    <div class="wrap home-hero-in">
      <div>
        <p class="kicker">Reviews independentes · 2026</p>
        <h1>Escolha o aparelho certo sem cair em propaganda</h1>
        <p class="subtitulo">Comparativos detalhados, prós e contras sinceros e guias de compra em linguagem simples. Você lê em poucos minutos e compra com segurança.</p>
        <div class="hero-botoes">
          {grupos.map((g) => <a class="btn" href={g.url}>{g.nome} →</a>)}
        </div>
      </div>
      <div class="home-ilu"><img src={categorias[1].imagem} alt="Ar-condicionado split inverter, um dos aparelhos comparados no site" width="600" height="600" fetchpriority="high" /></div>
    </div>
  </section>

  <section class="wrap">
    <h2>Categorias</h2>
    <div class="cats">
      {categorias.map((c) => (
        <a class="cat" href={c.hub}>
          <img src={c.imagem} alt="" width="600" height="600" loading="lazy" decoding="async" />
          <div>
            <h3>{c.nome}</h3>
            <p>{c.descricao}</p>
            <span class="ler">Ver os 10 melhores de 2026 →</span>
          </div>
        </a>
      ))}
      <div class="cat cat-breve">
        <div>
          <h3>Em breve</h3>
          <p>Climatizador, smart TV e outros aparelhos para a sua casa.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap">
    <h2>Comparativos e reviews</h2>
    <div class="guias">
      {comparativos.map((a) => (
        <a class="guia" href={a.url}>
          <img src={a.imagem} alt="" width="80" height="80" loading="lazy" decoding="async" />
          <span><small>{a.categoria}</small>{a.h1}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap">
    <h2>Guias práticos</h2>
    <div class="guias">
      {guias.map((a) => (
        <a class="guia" href={a.url}>
          <img src={a.imagem} alt="" width="80" height="80" loading="lazy" decoding="async" />
          <span><small>Guia</small>{a.h1}</span>
        </a>
      ))}
    </div>
    <p><a href="/guias/"><strong>Ver todos os guias →</strong></a></p>
  </section>

  <section class="wrap">
    <h2>Por que confiar no Melhores Aparelhos?</h2>
    <div class="motivos">
      <div><p class="m-ico">🔍</p><h3>Pesquisa cuidadosa</h3><p>Conferimos as especificações oficiais dos fabricantes, comparamos os modelos mais bem posicionados nos principais rankings e resumimos o que dizem os compradores.</p></div>
      <div><p class="m-ico">⚖️</p><h3>Prós e contras sinceros</h3><p>Todo produto tem defeitos. Mostramos os pontos fracos com a mesma clareza dos pontos fortes.</p></div>
      <div><p class="m-ico">📖</p><h3>Leitura fácil</h3><p>Sem "tecniquês". Explicamos BTU, inverter e decibéis como se fosse para um amigo.</p></div>
    </div>
  </section>

  <section class="leitura"><AuthorBox /></section>
</Base>

<style>
  .home-hero { background: linear-gradient(160deg, var(--azul-claro), #fff 75%); padding: 56px 0 40px; }
  .home-hero-in { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: center; }
  .kicker { font-weight: 700; color: var(--azul); text-transform: uppercase; letter-spacing: .08em; font-size: .9rem; }
  .hero-botoes { display: flex; flex-wrap: wrap; gap: 12px; }
  .home-ilu { max-width: 300px; justify-self: center; }
  .home-ilu img { border-radius: 24px; box-shadow: var(--sombra); background: #fff; }
  .cats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
  .cat { display: block; text-decoration: none; color: inherit; border: 1px solid var(--borda); border-radius: 20px; padding: 20px; background: #fff; transition: transform .15s, box-shadow .15s; }
  .cat:hover { transform: translateY(-3px); box-shadow: var(--sombra); color: inherit; }
  .cat img { width: 100%; max-width: 220px; aspect-ratio: 1; object-fit: contain; margin: 0 auto; }
  .cat h3 { margin: .8rem 0 .4rem; }
  .cat p { font-size: 1rem; color: var(--texto-2); }
  .cat-breve { background: var(--gelo); display: flex; align-items: center; border-style: dashed; }
  .ler { font-weight: 700; color: var(--azul); }
  .guias { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .guia { display: flex; gap: 14px; align-items: center; border: 1px solid var(--borda); border-radius: 14px; padding: 12px; text-decoration: none; color: var(--texto); font-weight: 700; font-size: 1rem; line-height: 1.35; background: #fff; }
  .guia:hover { border-color: var(--azul); color: var(--azul); }
  .guia img { width: 60px; height: 60px; object-fit: contain; flex-shrink: 0; }
  .guia small { display: block; font-weight: 600; color: var(--texto-2); font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; }
  .motivos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .motivos > div { background: var(--gelo); border-radius: 18px; padding: 24px; }
  .motivos h3 { margin-top: 0; }
  .motivos p { font-size: 1.02rem; }
  .m-ico { font-size: 2rem; margin: 0; }
  @media (max-width: 960px) { .guias, .cats { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) {
    .home-hero-in, .motivos, .guias, .cats { grid-template-columns: 1fr; }
    .home-ilu { display: none; }
  }
</style>
